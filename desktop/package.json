{
  "name": "garagepro-pc",
  "productName": "GaragePro",
  "version": "0.0.0",
  "description": "GaragePro — gestão de mecânica (versão para computador)",
  "author": "BBTecnoDev",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "electron-updater": "6.3.9"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "pt.bbtecnodev.garagepro.pc",
    "productName": "GaragePro",
    "copyright": "BBTecnoDev",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "preload.js", "app/**/*", "package.json"],
    "win": { "target": "nsis", "icon": "build/icon.png", "artifactName": "GaragePro-PC-Setup-${version}.${ext}" },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GaragePro",
      "deleteAppDataOnUninstall": false
    },
    "publish": [{ "provider": "generic", "url": "https://github.com/__REPO__/releases/latest/download" }]
  }
}
